@page "/"
<PageTitle>Oscar AI Arsenal</PageTitle>

<div class="wt-page">
    <main class="wt-main">

        <!-- HERO -->
        <section class="wt-hero">
            <div>
                <div class="wt-hero-badge">
                    <span>Secure • Local • Human-led</span>
                </div>

                <h1 class="wt-hero-title">
                    Battle-tested <span class="wt-hero-highlight">AI tools</span><br />
                    for people who take missions seriously.
                </h1>

                <p class="wt-hero-subtitle">
                    A curated arsenal of private, on-prem AI apps for contracts, spreadsheets,
                    and high-stakes decisions. Designed for teams that value security,
                    clarity, and walking in the light.
                </p>

                <div class="wt-hero-actions">
                    <button class="wt-btn-primary">
                        Request a demo
                    </button>

                    <button class="wt-btn-ghost">
                        <span>▶</span>
                        Watch a 90-second overview
                    </button>
                </div>
            </div>

            <!-- Right side: emblem + identity copy -->
            <aside class="wt-hero-panel">
                <img src="images/warrior-emblem.png"
                     alt="Warrior cross circuitry emblem"
                     style="width: 100%; border-radius: 1rem; border: 1px solid var(--border-soft);" />

                <div class="wt-hero-meta">
                    <strong>Soldier • Analyst • Builder</strong>
                </div>

                <div class="wt-hero-list">
                    <p>
                        Forged in combat, refined in data - now building secure, on-prem AI tools
                        designed for real-world clarity and responsibility.
                    </p>

                    <div class="wt-hero-chip-row">
                        <span class="wt-chip">No cloud</span>
                        <span class="wt-chip">No leaks</span>
                        <span class="wt-chip">C# • Python • SQL</span>
                    </div>
                </div>
            </aside>
        </section>

        <!-- APPS GRID -->
        <section class="wt-section">
            <header class="wt-section-header">
                <div>
                    <h2 class="wt-section-title">The Arsenal</h2>
                    <p class="wt-section-subtitle">
                        Each app focuses on one mission: reduce friction, reveal patterns,
                        and protect what matters most to your people, your time, and your decisions.
                    </p>
                </div>
            </header>

            <div class="wt-app-grid">
                <article class="wt-app-card">
                    <div class="wt-app-pill">Available</div>
                    <h3 class="wt-app-title">AICR - AI Contract Reviewer</h3>
                    <p class="wt-app-tagline">
                        Summarizes long contracts, highlights risk, and surfaces key clauses
                        in plain language without sending a single word to the cloud.
                    </p>
                    <p class="wt-app-meta">
                        Ideal for: vendor agreements, NDAs, renewals, policy reviews.
                    </p>
                    <a href="#aicr" class="wt-app-link">View AICR demo ↓</a>
                </article>

                <article class="wt-app-card">
                    <div class="wt-app-pill">Available</div>
                    <h3 class="wt-app-title">Excel Whisperer</h3>
                    <p class="wt-app-tagline">
                        Cleans dirty spreadsheets, builds summaries and pivots, and automates
                        recurring reports all from a simple, guided workflow.
                    </p>
                    <p class="wt-app-meta">
                        Ideal for: operations, finance, reporting, and recurring dashboards.
                    </p>
                    <a href="#excelwhisperer" class="wt-app-link">View Excel Whisperer demo ↓</a>
                </article>

                <article class="wt-app-card">
                    <div class="wt-app-pill">Prototype</div>
                    <h3 class="wt-app-title">ReadmitGuard</h3>
                    <p class="wt-app-tagline">
                        A privacy-first readmission risk explorer that surfaces patterns,
                        supports clinicians, and keeps PHI on your side of the firewall.
                    </p>
                    <p class="wt-app-meta">
                        Ideal for: hospitals exploring risk, quality, and care pathways.
                    </p>
                    <a href="#readmitguard" class="wt-app-link">View ReadmitGuard demos ↓</a>
                </article>


                <article class="wt-app-card">
                    <div class="wt-app-pill">In R&amp;D</div>
                    <h3 class="wt-app-title">Next Tool in the Stack</h3>
                    <p class="wt-app-tagline">
                        Reserved for your next mission from prospect funnels to
                        retention analytics and task automation.
                    </p>
                    <p class="wt-app-meta">
                        Built with the same principles: secure, explainable, and human-centered.
                    </p>
                </article>
            </div>
        </section>

        <!-- AICR FEATURE SECTION -->
        <section class="wt-section wt-section-aicr" id="aicr">
            <header class="wt-section-header">
                <div>
                    <h2 class="wt-section-title">AICR - AI Contract Reviewer</h2>
                    <p class="wt-section-subtitle">
                        Upload an NDA or contract and get instant red-flag visibility: missing IP,
                        no liability cap, weak indemnity, and more without a single token leaving
                        your network.
                    </p>
                </div>
            </header>

            <div class="wt-aicr-layout">
                <!-- Left: copy -->
                <div class="wt-aicr-copy wt-reveal">
                    <h3 class="wt-aicr-lead">Spot risks in seconds, not hours.</h3>
                    <ul class="wt-aicr-list">
                        <li>Drag-and-drop PDF or TXT contracts into a secure, local-only analyzer.</li>
                        <li>See extracted fields – parties, term, governing law – side by side.</li>
                        <li>Surface missing or risky clauses with plain-language explanations.</li>
                        <li>Export structured results for review, record-keeping, or workflows.</li>
                    </ul>
                    <p class="wt-aicr-footnote">
                        Mode + risk tolerance controls let you switch from “all signals” to “critical-only”
                        in one click, so you always see the level of detail that matches your review.
                    </p>
                </div>

                <!-- Right: screenshots + video -->
                <aside class="wt-aicr-visual wt-reveal">
                    <div class="wt-aicr-mainshot">
                        <img src="images/AICR/AICR-4.png"
                             alt="AICR contract reviewer showing extracted fields and statuses" />
                    </div>

                    <div class="wt-aicr-strip">
                        <img src="images/AICR/AICR-1.png"
                             alt="AICR contract upload screen with drag and drop area" />
                        <img src="images/AICR/AICR-3.png"
                             alt="AICR extracted fields table highlighting missing clauses" />
                        <img src="images/AICR/AICR-7.png"
                             alt="AICR red flags list and export options" />
                    </div>

                    <div class="wt-aicr-video">
                        <button type="button"
                                class="wt-video-overlay"
                                data-video-target="aicr-demo">
                            ▶
                        </button>

                        <video id="aicr-demo"
                               src="videos/aicr-contract-reader.mp4"
                               controls
                               preload="metadata">
                        </video>

                        <div class="wt-aicr-video-caption">
                            90-second demo running entirely on a local machine – no cloud, no leaks.
                        </div>
                    </div>
                </aside>
            </div>

        </section>

        <!-- EXCEL WHISPERER FEATURE SECTION -->
        <section class="wt-section wt-section-aicr" id="excelwhisperer">
            <header class="wt-section-header">
                <div>
                    <h2 class="wt-section-title">Excel Whisperer</h2>
                    <p class="wt-section-subtitle">
                        Clean messy spreadsheets, standardize columns, and turn recurring work
                        into guided, repeatable flows – without sending your data to the cloud.
                    </p>
                </div>
            </header>

            <div class="wt-aicr-layout">
                <!-- Left: copy -->
                <div class="wt-aicr-copy wt-reveal">
                    <h3 class="wt-aicr-lead">Turn chaos into clear, reusable reports.</h3>
                    <ul class="wt-aicr-list">
                        <li>Upload CSV or Excel files into a local-only processing workflow.</li>
                        <li>Clean headers, normalize values, and flag obvious data issues.</li>
                        <li>Generate summaries, pivots, and key KPIs with a few guided clicks.</li>
                        <li>Export refreshed sheets or ready-to-send report packs on demand.</li>
                    </ul>
                    <p class="wt-aicr-footnote">
                        Designed for recurring workflows – month-end reports, team dashboards,
                        and operational spreadsheets that can’t afford broken formulas or leaks.
                    </p>
                </div>

                <!-- Right: screenshots + video -->
                <aside class="wt-aicr-visual wt-reveal">
                    <div class="wt-aicr-mainshot">
                        <img src="images/ExcelWhisperer/EW-1.png"
                             alt="Excel Whisperer main upload and controls screen" />
                    </div>

                    <div class="wt-aicr-strip">
                        <img src="images/ExcelWhisperer/EW-2.png"
                             alt="Excel Whisperer cleaned table with standardized columns" />
                        <img src="images/ExcelWhisperer/EW-3.png"
                             alt="Excel Whisperer summarized view of key metrics" />
                        <img src="images/ExcelWhisperer/EW-4.png"
                             alt="Excel Whisperer export and automation options" />
                    </div>

                    <div class="wt-aicr-video">
                        <button type="button"
                                class="wt-video-overlay"
                                data-video-target="ew-demo">
                            ▶
                        </button>

                        <video id="ew-demo"
                               src="videos/excel-whisperer-demo.mp4"
                               controls
                               preload="metadata">
                        </video>

                        <div class="wt-aicr-video-caption">
                            90-second walkthrough: from messy spreadsheet to clean, reusable report.
                        </div>
                    </div>
                </aside>
            </div>
        </section>

        <!-- READMITGUARD FEATURE SECTION -->
        <section class="wt-section wt-section-aicr" id="readmitguard">
            <header class="wt-section-header">
                <div>
                    <h2 class="wt-section-title">ReadmitGuard - Hospital Readmission Predictor</h2>
                    <p class="wt-section-subtitle">
                        A privacy-first readmission risk explorer that lets you score individual patients
                        or full cohorts, while keeping PHI locked inside your own environment.
                    </p>
                </div>
            </header>

            <!-- ROW 1: Manual entry + explainability -->
            <div class="wt-aicr-layout">
                <!-- Left: copy -->
                <div class="wt-aicr-copy wt-reveal">
                    <h3 class="wt-aicr-lead">Score a single patient with full explainability.</h3>
                    <ul class="wt-aicr-list">
                        <li>Enter simple clinical features - age, LOS, prior visits, procedures, ED flag.</li>
                        <li>See readmission risk instantly with a tunable decision threshold.</li>
                        <li>Inspect ROC / PR curves so clinicians can see how the model behaves.</li>
                        <li>Use calibration and SHAP to understand whether the model is well-tuned and why it made this call.</li>
                    </ul>
                    <p class="wt-aicr-footnote">
                        Built for decision support, not diagnosis. Every screen is designed to help humans ask
                        better questions, not replace their judgment.
                    </p>
                </div>

                <!-- Right: screenshots + manual-entry video -->
                <aside class="wt-aicr-visual wt-reveal">
                    <div class="wt-aicr-mainshot">
                        <img src="images/ReadmitGuard/Manual/RG-M-1.png"
                             alt="ReadmitGuard quick scorer with patient inputs for readmission prediction" />
                    </div>

                    <div class="wt-aicr-strip">
                        <img src="images/ReadmitGuard/Manual/RG-M-2.png"
                             alt="ReadmitGuard ROC and precision-recall curves for model performance" />
                        <img src="images/ReadmitGuard/Manual/RG-M-3.png"
                             alt="ReadmitGuard reliability curve showing calibration quality" />
                        <img src="images/ReadmitGuard/Manual/RG-M-4.png"
                             alt="ReadmitGuard SHAP bar chart showing feature contributions" />
                    </div>

                    <div class="wt-aicr-video">
                        <button type="button"
                                class="wt-video-overlay"
                                data-video-target="rg-manual-demo">
                            ▶
                        </button>

                        <video id="rg-manual-demo"
                               src="videos/readmitguard-manual-demo.mp4"
                               controls
                               preload="metadata">
                        </video>

                        <div class="wt-aicr-video-caption">
                            Manual entry demo: from a single patient’s data to calibrated risk and SHAP-driven explanations.
                        </div>
                    </div>
                </aside>
            </div>

            <!-- ROW 2: CSV / cohort analysis -->
            <div class="wt-aicr-layout">
                <!-- Left: copy -->
                <div class="wt-aicr-copy wt-reveal">
                    <h3 class="wt-aicr-lead">Upload a cohort and surface patterns in minutes.</h3>
                    <ul class="wt-aicr-list">
                        <li>Drag-and-drop CSV risk files straight into a secure, local-only workflow.</li>
                        <li>Get instant summaries of record counts, score distributions, and key fields.</li>
                        <li>Spot your highest-risk patients and compare them against the rest of the cohort.</li>
                        <li>Export top-N lists or full datasets for downstream QA, quality, or care-pathway work.</li>
                    </ul>
                    <p class="wt-aicr-footnote">
                        Designed for hospital quality, analytics, and data science teams who need fast
                        feedback loops without exposing PHI to external services.
                    </p>
                </div>

                <!-- Right: screenshots + CSV video -->
                <aside class="wt-aicr-visual wt-reveal">
                    <div class="wt-aicr-mainshot">
                        <img src="images/ReadmitGuard/CSV/RG-C-2.png"
                             alt="ReadmitGuard cohort summary table with readmission risk features" />
                    </div>

                    <div class="wt-aicr-strip">
                        <img src="images/ReadmitGuard/CSV/RG-C-1.png"
                             alt="ReadmitGuard file upload area for CSV risk data" />
                        <img src="images/ReadmitGuard/CSV/RG-C-3.png"
                             alt="ReadmitGuard top 5 highest risk patients table" />
                        <img src="images/ReadmitGuard/CSV/RG-C-4.png"
                             alt="ReadmitGuard full summary statistics for the cohort" />
                    </div>

                    <div class="wt-aicr-video">
                        <button type="button"
                                class="wt-video-overlay"
                                data-video-target="rg-csv-demo">
                            ▶
                        </button>

                        <video id="rg-csv-demo"
                               src="videos/readmitguard-csv-demo.mp4"
                               controls
                               preload="metadata">
                        </video>

                        <div class="wt-aicr-video-caption">
                            CSV demo: upload a hospital cohort, summarize risk, and export the insights you need.
                        </div>
                    </div>
                </aside>
            </div>
        </section>

        <!-- PILLARS -->
        <section class="wt-section">
            <header class="wt-section-header">
                <div>
                    <h2 class="wt-section-title">Why this stack exists</h2>
                    <p class="wt-section-subtitle">
                        These aren’t toys or generic chatbots. They’re focused tools, shaped by
                        real-world pressure where failure isn’t just an inconvenience.
                    </p>
                </div>
            </header>

            <div class="wt-pillars">
                <div class="wt-pillar">
                    <div class="wt-pillar-title">Security first, not as an afterthought.</div>
                    <p class="wt-pillar-text">
                        Local-first designs, no silent API calls to mystery endpoints, and
                        clear data boundaries. If it touches sensitive information, it stays
                        inside your walls.
                    </p>
                </div>

                <div class="wt-pillar">
                    <div class="wt-pillar-title">Built by someone who’s worn the weight.</div>
                    <p class="wt-pillar-text">
                        From combat zones to city hall, these tools were shaped by real-world
                        responsibility where bad data has real consequences.
                    </p>
                </div>

                <div class="wt-pillar">
                    <div class="wt-pillar-title">Clarity over hype.</div>
                    <p class="wt-pillar-text">
                        Every screen is designed to answer a question: “What should I do next?”
                        Less noise, more signal, always grounded in reality.
                    </p>
                </div>
            </div>

            <div class="wt-cta">
                <div class="wt-cta-main">
                    <h3 class="wt-cta-title">Want to see how this fits your mission?</h3>
                    <p>
                        Show me your current workflow, and I’ll map which tool or combination
                        gives you the fastest, safest win. No hype. Just clarity grounded in
                        real-world pressure.
                    </p>
                </div> 
            </div>
        </section>
    </main>

    <footer class="wt-footer">
        <div>
            © @DateTime.Now.Year - Oscar Holguin.<br />
            Built with C#, Blazor, and a refusal to compromise on security.
        </div>
        <div>
            <span>Future links:&nbsp;</span>
            <a href="#">Docs</a> · <a href="#">Demo request</a> · <a href="#">Contact</a>
        </div>
    </footer>
</div>
