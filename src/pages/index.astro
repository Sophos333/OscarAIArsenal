---
import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/ContactSection.astro';
import SophosAssistant from '../components/SophosAssistant.astro';
import HeroSlider from '../components/HeroSlider.astro';
import EvidenceCarousel from '../components/EvidenceCarousel.astro';

import heroAicr from '../assets/evidence/hero-aicr-findings.webp';
import heroScout from '../assets/evidence/hero-scout-results.webp';
import aicrInput from '../assets/evidence/aicr-01-contract-input.webp';
import aicrFindings from '../assets/evidence/aicr-02-findings.webp';
import aicrEvidence from '../assets/evidence/aicr-03-supporting-evidence.webp';
import aicrComparison from '../assets/evidence/aicr-04-comparison.webp';
import scoutSetup from '../assets/evidence/scout-01-search-setup.webp';
import scoutResults from '../assets/evidence/scout-02-validated-results.webp';
import scoutEvaluation from '../assets/evidence/scout-03-prospect-evaluation.webp';
import scoutEvidence from '../assets/evidence/scout-04-first-party-evidence.webp';

const heroSlides = [
  {
    title: 'AI Contract Reviewer',
    description:
      'Review contract terms, possible risks, and supporting language before making a decision.',
    image: heroAicr,
    imageAlt: 'AI Contract Reviewer showing contract findings and supporting evidence controls.',
    href: '#aicr-evidence',
    cta: 'See AICR’s workflow',
  },
  {
    title: 'Scout',
    description:
      'Find candidate companies, review their fit, and inspect first-party evidence.',
    image: heroScout,
    imageAlt: 'Scout showing validated company results from an Orlando property-management search.',
    href: '#scout-evidence',
    cta: 'See Scout’s workflow',
  },
];

const aicrWorkflow = [
  {
    title: 'Load a contract',
    caption: 'Load a PDF or TXT agreement for review.',
    image: aicrInput,
    imageAlt: 'AI Contract Reviewer contract upload screen with a sample NDA loaded for review.',
  },
  {
    title: 'Review possible risks',
    caption: 'Review possible risks and missing terms surfaced for human inspection.',
    image: aicrFindings,
    imageAlt: 'AI Contract Reviewer red-flags table showing critical and warning-level findings.',
  },
  {
    title: 'Check supporting language',
    caption: 'Inspect extracted passages and where matching language was not detected.',
    image: aicrEvidence,
    imageAlt: 'AI Contract Reviewer supporting evidence view showing extracted NDA passages and no renewal language detected.',
  },
  {
    title: 'Compare agreements',
    caption: 'Compare extracted contract wording side by side before deciding what needs attention.',
    image: aicrComparison,
    imageAlt: 'AI Contract Reviewer comparison view showing different party wording from two agreements.',
  },
];

const scoutWorkflow = [
  {
    title: 'Set the search',
    caption: 'Set the company type, location, and number of prospects to evaluate.',
    image: scoutSetup,
    imageAlt: 'Scout search form configured for property-management companies in Orlando, Florida.',
  },
  {
    title: 'Review validated candidates',
    caption: 'Review the candidate companies that passed the search validation checks.',
    image: scoutResults,
    imageAlt: 'Scout results showing 20 requested prospects, 16 evaluated candidates, and 7 accepted companies.',
  },
  {
    title: 'Inspect why a prospect was kept',
    caption: 'Review fit evidence, cautions, priority, and contact readiness before continuing.',
    image: scoutEvaluation,
    imageAlt: 'Scout prospect evaluation showing fit, evidence score, priority, cautions, and contact readiness.',
  },
  {
    title: 'Open the first-party evidence',
    caption: 'Inspect the first-party source pages behind the prospect research.',
    image: scoutEvidence,
    imageAlt: 'Scout first-party evidence view showing the source page and captured evidence highlights.',
  },
];

const systems = [
  {
    title: 'AI Contract Reviewer',
    description:
      'A first pass over contract terms, possible risks, and supporting text for human review.',
    videoUrl: 'https://www.youtube.com/embed/CkHkTkwjyb4',
    tags: ['Python', 'AI', 'Risk Analysis'],
    link: '/projects/aicr'
  },
  {
    title: 'Cerebro',
    description:
      'A demonstration of how answers from the same document change with the user’s role.',
    videoUrl: 'https://www.youtube.com/embed/jBkj_bx1O8E',
    tags: ['AI', 'RBAC', 'Security'],
    link: '/projects/cerebro'
  },
  {
    title: 'Aegis',
    description:
      'A demonstration of approved, read-only queries for exploring business data.',
    videoUrl: 'https://www.youtube.com/embed/H62c5nuIJ04',
    tags: ['AI', 'Governance', 'Decision Intelligence'],
    link: '/projects/aegis'
  },
  {
    title: 'Excel Whisperer',
    description:
      'Spreadsheet analysis and reporting with Python.',
    videoUrl: 'https://www.youtube.com/embed/wH5GimNodVo',
    tags: ['Python', 'Excel', 'Automation']
  },
  {
    title: 'ReadmitGuard Manual Entry',
    description:
      'A demonstration of readmission-risk estimation from manually entered patient data. It does not replace clinical judgment.',
    videoUrl: 'https://www.youtube.com/embed/dhHS-pOz__I',
    tags: ['Healthcare AI', 'ML', 'Prediction']
  },
  {
    title: 'ReadmitGuard CSV Batch',
    description:
      'A demonstration of readmission-risk estimation for records supplied in a CSV file. It does not replace clinical judgment.',
    videoUrl: 'https://www.youtube.com/embed/NhVMz8I6Z-Y',
    tags: ['CSV', 'Healthcare', 'Analytics']
  }
];
---

<Layout>
  <main class="min-h-screen bg-slate-950 pt-20 text-white">
    <section class="relative overflow-hidden px-6 py-12 sm:px-10 lg:px-16">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(124,58,237,0.35),transparent_30%),radial-gradient(circle_at_top_right,rgba(6,182,212,0.25),transparent_30%)]"></div>

      <div class="relative mx-auto grid max-w-[1200px] items-center gap-12 lg:grid-cols-[520px_minmax(0,560px)] lg:justify-between">
        <div class="animate-[fadeIn_0.8s_ease-out]">
          <p class="mb-4 inline-flex rounded-full border border-cyan-400/30 bg-cyan-400/10 px-4 py-2 text-sm font-medium text-cyan-200">
            Built by Oscar Holguin-Silva
          </p>

          <div class="flex items-center gap-5">
            <img
              src={`${import.meta.env.BASE_URL}images/ai-arsenal-emblem.png`}
              alt="AI Arsenal emblem"
              class="h-24 w-24 flex-shrink-0 object-contain sm:h-32 sm:w-32 lg:h-36 lg:w-36"
            />

            <h1 class="text-5xl font-extrabold leading-[0.9] sm:text-6xl lg:text-6xl">
              <span class="bg-gradient-to-r from-white via-cyan-200 to-cyan-400 bg-clip-text text-transparent">
                AI
              </span>
              <span class="block bg-gradient-to-r from-white via-cyan-200 to-cyan-400 bg-clip-text text-transparent">
                Arsenal
              </span>
            </h1>
          </div>

          <p class="mt-4 text-base text-cyan-200">
            “Here am I. Send me.”
            <span class="text-sm text-slate-400">— Isaiah 6:8</span>
          </p>

          <p class="mt-4 max-w-2xl text-xl leading-8 text-slate-300">
            I build AI tools for contract review, data analysis, and workflow automation.
          </p>

          <p class="mt-4 max-w-2xl text-base leading-7 text-slate-400">
            The demos below show what each tool does, what it produces,
            and where human review still matters.
          </p>

          <div class="mt-4 flex flex-wrap gap-2">
            {["Python", "SQL", "Streamlit", "FastAPI"].map((tech) => (
              <span class="rounded-full border border-cyan-400/20 bg-cyan-400/10 px-3 py-1 text-xs font-semibold text-cyan-200">
                {tech}
              </span>
            ))}
          </div>

          <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:gap-6">
            <a
              href="#systems"
              class="rounded-full bg-cyan-400 px-6 py-3 text-center text-sm font-bold text-slate-950 transition-all duration-300 hover:-translate-y-1 hover:bg-cyan-300 hover:shadow-[0_0_20px_rgba(6,182,212,0.35)]"
            >
              View Systems
            </a>

            <a
              href="#contact"
              class="group inline-flex items-center justify-center gap-2 rounded-full border border-white/15 bg-white/5 px-6 py-3 text-center text-sm font-bold text-white transition-all duration-300 hover:-translate-y-1 hover:border-white/30 hover:bg-white/10 hover:shadow-[0_0_20px_rgba(255,255,255,0.15)]"
            >
              <span>Contact</span>
              <span class="transition-transform duration-300 group-hover:translate-x-2">→</span>
            </a>

            <a
              href="https://github.com/Sophos333"
              target="_blank"
              rel="noopener noreferrer"
              class="text-center text-sm font-semibold text-slate-400 underline decoration-white/20 underline-offset-4 transition hover:text-white hover:decoration-white/50"
            >
              GitHub projects
            </a>
          </div>
        </div>

        <HeroSlider slides={heroSlides} />
      </div>
    </section>

    <section id="workflows" class="border-y border-white/5 bg-slate-900/20 px-6 py-16 sm:px-10 lg:px-16">
      <div class="mx-auto max-w-[1120px]">
        <h2 class="text-center text-3xl font-bold sm:text-4xl">
          AICR and Scout, step by step.
        </h2>

        <div class="mt-10 space-y-12">
          <EvidenceCarousel
            id="aicr-evidence"
            product="AI Contract Reviewer"
            boundary="AICR supports your review. It does not provide legal advice or make signing decisions."
            slides={aicrWorkflow}
            accent="cyan"
          />

          <EvidenceCarousel
            id="scout-evidence"
            product="Scout"
            boundary="Review the evidence and contact route before deciding to reach out."
            slides={scoutWorkflow}
            accent="amber"
          />
        </div>
      </div>
    </section>

    <section id="systems" class="px-6 py-20 sm:px-10 lg:px-16">
      <div class="mx-auto max-w-7xl">
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-cyan-300">
          Featured Systems
        </p>

        <h2 class="mt-4 text-3xl font-bold sm:text-4xl">
          Watch the tools in use.
        </h2>

        <div class="mt-10 grid gap-8 lg:grid-cols-2">
          {systems.map((system) => (
            <article class="group rounded-3xl border border-white/10 bg-white/5 p-6 transition duration-300 hover:-translate-y-2 hover:border-cyan-400/30 hover:bg-white/10 hover:shadow-xl hover:shadow-cyan-900/40">
              <div class="overflow-hidden rounded-2xl border border-white/10 bg-slate-900/80">
                <iframe
                  src={system.videoUrl}
                  title={`${system.title} Demo`}
                  class="aspect-video w-full"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  loading="lazy"
                ></iframe>
              </div>

              <div class="mt-6">
                <h3 class="text-2xl font-bold">{system.title}</h3>

                <p class="mt-3 text-sm leading-7 text-slate-400">
                  {system.description}
                </p>

                <div class="mt-5 flex flex-wrap gap-2">
                  {system.tags.map((tag) => (
                    <span class="rounded-full border border-cyan-400/20 bg-cyan-400/10 px-3 py-1 text-xs font-medium text-cyan-200">
                      {tag}
                    </span>
                  ))}
                </div>

                {system.link && (
                  <a
                    href={`${import.meta.env.BASE_URL}${system.link.replace(/^\//, "")}`}
                    class="group mt-6 inline-flex items-center gap-2 rounded-full border border-cyan-400/30 bg-cyan-400/10 px-5 py-2.5 text-sm font-semibold text-cyan-300 transition-all duration-300 hover:-translate-y-1 hover:border-cyan-300 hover:bg-cyan-400/20 hover:shadow-[0_0_20px_rgba(34,211,238,0.35)]"
                  >
                    <span>View Details</span>
                    <span class="transition-transform duration-300 group-hover:translate-x-2">→</span>
                  </a>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <ContactSection />
    <SophosAssistant />
  </main>

  <style>
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(15px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</Layout>
