---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
  <main class="pt-20 min-h-screen bg-slate-950 px-6 py-20 text-white sm:px-10 lg:px-16">

    <section class="mx-auto max-w-6xl text-center">

      <p class="text-sm font-semibold uppercase tracking-[0.35em] text-cyan-300">
        Aegis
      </p>

      <h1 class="mt-6 text-4xl font-extrabold sm:text-5xl lg:text-6xl">
        Run approved business queries through a read-only data path.
      </h1>

      <p class="mx-auto mt-6 max-w-3xl text-lg text-slate-300">
        Aegis lets leadership explore approved business metrics through governed SQL templates. Queries are restricted to a single governed view, validated before execution, and logged for review.
      </p>

      <div class="mx-auto mt-12 max-w-5xl overflow-hidden rounded-3xl border border-white/10 bg-slate-900/80 shadow-2xl">

        <iframe
          src="https://www.youtube.com/embed/H62c5nuIJ04"
          class="aspect-video w-full"
          allowfullscreen
        ></iframe>

      </div>

    </section>

    <section class="mx-auto mt-20 grid max-w-6xl gap-6 md:grid-cols-3">

      <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <h2 class="text-xl font-bold text-cyan-300">Approved questions</h2>
        <p class="mt-4 text-slate-300">
          Use predefined analytical templates for revenue trends, top customers, top products, period-over-period comparisons, and other governed metrics.
        </p>
      </div>

      <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <h2 class="text-xl font-bold text-cyan-300">Read-only boundary</h2>
        <p class="mt-4 text-slate-300">
          Aegis permits SELECT-only queries against one governed SQL view. Write operations, free-form SQL, schema crawling, and multi-statement execution are blocked.
        </p>
      </div>

      <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
        <h2 class="text-xl font-bold text-cyan-300">Audit every run</h2>
        <p class="mt-4 text-slate-300">
          Each execution attempt records the template, status, duration, rows returned, parameters, and error details when applicable.
        </p>
      </div>

    </section>

    <section class="mx-auto mt-24 max-w-5xl text-center">

      <h2 class="text-2xl font-bold text-white drop-shadow-[0_0_10px_rgba(34,211,238,0.4)]">
        See governed analytics in action
      </h2>

      <p class="mt-5 text-slate-300">
        Aegis demonstrates how approved business questions can be answered through a constrained, auditable, read-only workflow.
      </p>

      <a
        href={`${import.meta.env.BASE_URL}#contact`}
        class="group mt-10 inline-flex items-center gap-2 rounded-full border border-cyan-400/30 bg-cyan-400/10 px-6 py-3 text-sm font-semibold text-cyan-300 transition-all duration-300 hover:-translate-y-1 hover:border-cyan-300 hover:bg-cyan-400/20 hover:shadow-[0_0_25px_rgba(34,211,238,0.45)]"
      >
        <span>Ask about Aegis</span>
        <span class="transition-transform duration-300 group-hover:translate-x-2">→</span>
      </a>

    </section>

  </main>
</Layout>
