---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Message Received | AI Arsenal">
  <main class="min-h-screen bg-slate-950 px-6 py-20 text-white">
    <section class="thank-you-reveal mx-auto flex max-w-3xl flex-col items-center rounded-3xl border border-white/10 bg-white/5 p-10 text-center shadow-2xl shadow-cyan-950/40">
      <img
        src={`${import.meta.env.BASE_URL}images/AI_Arsenal_Logo.jpg`}
        alt="AI Arsenal logo"
        class="thank-you-logo h-44 w-44 rounded-3xl object-cover shadow-2xl shadow-cyan-500/50 md:h-56 md:w-56"
      />

      <p class="mt-8 text-sm font-semibold uppercase tracking-[0.25em] text-cyan-300">
        Message received
      </p>

      <h1 class="mt-4 text-4xl font-bold">
        Thank you for reaching out.
      </h1>

      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-300">
        Your message has been sent to AI Arsenal. I’ll review it and respond as soon as possible.
      </p>

      <a
        href={import.meta.env.BASE_URL}
        class="mt-8 rounded-full bg-cyan-400 px-7 py-3 text-sm font-bold text-slate-950 transition hover:-translate-y-1 hover:bg-cyan-300"
      >
        Back to AI Arsenal
      </a>
    </section>
  </main>
  <style>
    /* WAYPOINT: THANK_YOU_POLISH */
    .thank-you-reveal {
      animation: thankYouReveal 700ms ease-out both;
    }

    @keyframes thankYouReveal {
      from {
        opacity: 0;
        transform: translateY(18px) scale(0.98);
      }

      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
    /* WAYPOINT: LOGO_GLOW */
  .thank-you-reveal img {
    filter: drop-shadow(0 0 18px rgba(0, 255, 200, 0.35));
  }
  /* WAYPOINT: THANK_YOU_LOGO_ANIMATION */
  .thank-you-logo {
    animation: logoGlowPulse 5s ease-in-out infinite;
    transform-origin: center;
  }

  @keyframes logoArrival {
    0% {
      opacity: 0;
      transform: translateY(0) scale(1);
      filter: drop-shadow(0 0 0 rgba(0, 255, 200, 0));
    }

    70% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: drop-shadow(0 0 24px rgba(0, 255, 200, 0.45));
    }

    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: drop-shadow(0 0 18px rgba(0, 255, 200, 0.35));
    }
  }
  @keyframes logoGlowPulse {
    0%, 100% {
      filter: drop-shadow(0 0 14px rgba(0, 255, 200, 0.25));
    }

    50% {
      filter: drop-shadow(0 0 28px rgba(0, 255, 200, 0.50));
    }
  }
</style>

  <script>
    // WAYPOINT: THANK_YOU_SCROLL_TOP
    window.addEventListener("load", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  </script>
</Layout>











