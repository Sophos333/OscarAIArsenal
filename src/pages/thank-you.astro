---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Message Received | AI Arsenal">
  <main class="min-h-screen bg-slate-950 px-6 py-20 text-white">
    <section class="mx-auto flex max-w-3xl flex-col items-center rounded-3xl border border-white/10 bg-white/5 p-10 text-center shadow-2xl shadow-cyan-950/40">
      <img
        src="/images/AI_Arsenal_Logo.jpg"
        alt="AI Arsenal logo"
        class="h-24 w-24 rounded-2xl object-cover shadow-2xl shadow-cyan-900/40"
      />

      <p class="mt-8 text-sm font-semibold uppercase tracking-[0.25em] text-cyan-300">
        Message received
      </p>

      <h1 class="mt-4 text-4xl font-bold">
        Thank you for reaching out.
      </h1>

      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-300">
        Your message has been sent to AI Arsenal. I’ll review it and respond as soon as possible.
      </p>

      <a
        href="/"
        class="mt-8 rounded-full bg-cyan-400 px-7 py-3 text-sm font-bold text-slate-950 transition hover:-translate-y-1 hover:bg-cyan-300"
      >
        Back to AI Arsenal
      </a>
    </section>
  </main>
</Layout>
