---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}images/cross-badge.png`} />
		<link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}images/cross-badge.png`} />
		<meta name="generator" content={Astro.generator} />
		<title>Ai Arsenal</title>
	</head>
	<body>
  <nav class="fixed top-0 left-0 w-full z-50 bg-slate-950/80 backdrop-blur border-b border-white/10">
    <div class="max-w-6xl mx-auto flex items-center justify-between px-6 py-3">
      
      <a href={`${import.meta.env.BASE_URL}`} class="text-white font-bold">
        AI Arsenal
      </a>

      <div class="flex gap-6 text-sm">
        <a href={`${import.meta.env.BASE_URL}`} class="relative text-slate-300 transition-all duration-300 hover:text-cyan-300 hover:-translate-y-[1px] after:absolute after:-bottom-1 after:left-0 after:h-px after:w-0 after:bg-cyan-300 after:transition-all after:duration-300 hover:after:w-full">
          Home
        </a>

        <a href={`${import.meta.env.BASE_URL}#contact`} class="relative text-slate-300 transition-all duration-300 hover:text-cyan-300 hover:-translate-y-[1px] after:absolute after:-bottom-1 after:left-0 after:h-px after:w-0 after:bg-cyan-300 after:transition-all after:duration-300 hover:after:w-full">
          Contact
        </a>
      </div>

    </div>
  </nav>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>



