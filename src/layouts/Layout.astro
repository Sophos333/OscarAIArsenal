---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}images/ai-arsenal-cross-circuit-32.png`} />
		<link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}images/ai-arsenal-cross-circuit-16.png`} />
		<meta name="generator" content={Astro.generator} />
		<title>Ai Arsenal</title>
	</head>
	<body>
  <nav class="fixed top-0 left-0 w-full z-50 bg-slate-950/80 backdrop-blur border-b border-white/10">
    <div class="max-w-6xl mx-auto flex items-center justify-between px-6 py-3">
      <a href={`${import.meta.env.BASE_URL}`} class="flex items-center gap-3 text-white font-bold">
        <img
          src={`${import.meta.env.BASE_URL}images/ai-arsenal-emblem.png`}
          alt="AI Arsenal emblem"
          class="h-9 w-9 object-contain"
        />
        <span>AI Arsenal</span>
      </a>

      <div class="hidden gap-6 text-sm sm:flex">
        <a href={`${import.meta.env.BASE_URL}`} class="relative text-slate-300 transition-all duration-300 hover:text-cyan-300 hover:-translate-y-[1px] after:absolute after:-bottom-1 after:left-0 after:h-px after:w-0 after:bg-cyan-300 after:transition-all after:duration-300 hover:after:w-full">
          Home
        </a>

        <a href={`${import.meta.env.BASE_URL}#contact`} class="relative text-slate-300 transition-all duration-300 hover:text-cyan-300 hover:-translate-y-[1px] after:absolute after:-bottom-1 after:left-0 after:h-px after:w-0 after:bg-cyan-300 after:transition-all after:duration-300 hover:after:w-full">
          Contact
        </a>
      </div>

      <!-- WAYPOINT: MOBILE_NAV_TOGGLE -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-xl text-cyan-200 transition hover:bg-white/10 sm:hidden"
        aria-label="Open mobile menu"
        aria-expanded="false"
      >
        ☰
      </button>
    </div>

    <!-- WAYPOINT: MOBILE_NAV_MENU -->
    <div id="mobile-menu" class="hidden border-t border-white/10 bg-slate-950/95 px-6 py-5 sm:hidden">
      <div class="mb-4 flex items-center gap-3">
        <img
          src={`${import.meta.env.BASE_URL}images/ai-arsenal-emblem.png`}
          alt="AI Arsenal emblem"
          class="h-10 w-10 object-contain"
        />
        <div>
          <p class="text-sm font-bold text-white">AI Arsenal</p>
          <p class="text-xs text-slate-400">Systems, demos, and decision tools</p>
        </div>
      </div>

      <label class="grid gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-cyan-300">
        Search
        <input
          type="search"
          placeholder="Search systems..."
          class="rounded-2xl border border-white/10 bg-slate-900/80 px-4 py-3 text-sm text-white outline-none placeholder:text-slate-500 focus:border-cyan-400/50"
        />
      </label>

      <div class="mt-5 grid gap-3 text-sm">
        <a href={`${import.meta.env.BASE_URL}`} class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-slate-200 transition hover:bg-cyan-400/10 hover:text-cyan-200">
          Home
        </a>

        <a href={`${import.meta.env.BASE_URL}#systems`} class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-slate-200 transition hover:bg-cyan-400/10 hover:text-cyan-200">
          Systems
        </a>

        <a href={`${import.meta.env.BASE_URL}#contact`} class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-slate-200 transition hover:bg-cyan-400/10 hover:text-cyan-200">
          Contact
        </a>
      </div>
    </div>
  </nav>

  <slot />

  <!-- WAYPOINT: SITE_FOOTER -->
  <footer class="border-t border-white/10 bg-slate-950 px-6 py-10 text-slate-300 sm:px-10 lg:px-16">
    <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-2 md:items-start">
      <div>
        <p class="font-bold text-white">AI Arsenal Enterprise</p>
        <p class="mt-2 max-w-xl text-sm leading-6">
          <span class="text-cyan-200">“Here am I. Send me.”</span><span class="text-slate-400"> — Isaiah 6:8</span>
        </p>
      </div>

      <div class="md:text-right">
        <p class="text-sm font-semibold text-white">Contact</p>

        <div class="mt-3 flex flex-col gap-2 text-sm md:items-end">
          <a
            href="tel:+14078539365"
            class="transition hover:text-cyan-300"
          >
            (407) 853-9365
          </a>

          <a
            href="mailto:AI.Arsenalenterprise@gmail.com"
            class="break-all transition hover:text-cyan-300"
          >
            AI.Arsenalenterprise@gmail.com
          </a>
        </div>

        <div class="mt-4 flex gap-3 md:justify-end" aria-label="Social profiles">
          <a
            href="https://www.linkedin.com/in/yashuasspear-oscar-holguin-silva/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Oscar Holguin-Silva on LinkedIn"
            class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 text-slate-300 transition hover:border-cyan-400/40 hover:text-cyan-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-5 w-5"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
            </svg>
          </a>

          <a
            href="https://github.com/Sophos333"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Oscar Holguin-Silva on GitHub"
            class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 text-slate-300 transition hover:border-cyan-400/40 hover:text-cyan-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"
          >
            <svg
              viewBox="0 0 24 24"
              class="h-5 w-5"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M12 .297a12 12 0 0 0-3.793 23.388c.6.113.82-.258.82-.577v-2.234c-3.338.726-4.043-1.416-4.043-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.31.469-2.381 1.236-3.221-.124-.303-.536-1.526.117-3.176 0 0 1.008-.322 3.301 1.23a11.52 11.52 0 0 1 6.006 0c2.291-1.552 3.297-1.23 3.297-1.23.655 1.65.243 2.873.119 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .322.218.694.825.576A12 12 0 0 0 12 .297z" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="mx-auto mt-8 max-w-6xl border-t border-white/10 pt-6">
      <p class="text-xs leading-6 text-slate-500">
        Privacy notice: Contact information submitted through this website is used to respond to your inquiry. Please do not send passwords, confidential documents, private health information, or other sensitive data.
      </p>

      <p class="mt-3 text-xs text-slate-600">
        © AI Arsenal Enterprise.
      </p>
    </div>
  </footer>

  <script>
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');

    mobileMenuToggle?.addEventListener('click', () => {
      const isOpen = !mobileMenu?.classList.contains('hidden');

      mobileMenu?.classList.toggle('hidden');
      mobileMenuToggle.setAttribute('aria-expanded', String(!isOpen));
      mobileMenuToggle.textContent = isOpen ? '☰' : '×';
    });
  </script></body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>





