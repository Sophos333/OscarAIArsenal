---
---

<!-- WAYPOINT: SOPHOS_AI_ARSENAL_ASSISTANT -->
<div id="sophos-root" class="fixed bottom-3 right-3 z-50 sm:bottom-6 sm:right-6">
  <button
    id="sophos-toggle"
    type="button"
    class="sophos-pulse sophos-orb flex h-14 w-14 items-center justify-center rounded-full border border-cyan-400/30 bg-cyan-400 text-2xl shadow-2xl shadow-cyan-900/40 transition hover:bg-cyan-300 sm:h-16 sm:w-16"
    aria-label="Open AI Arsenal System Guide"
  >
    <img src={`${import.meta.env.BASE_URL}images/sophos-icon.png`} alt="Sophos AI assistant" class="h-9 w-9 object-contain" />
  </button>

  <div
    id="sophos-panel"
    data-base-url={import.meta.env.BASE_URL}
    class="fixed inset-3 hidden min-h-0 flex-col overflow-hidden rounded-3xl border border-white/10 bg-slate-950/95 text-white shadow-2xl shadow-cyan-950/50 backdrop-blur sm:inset-auto sm:bottom-6 sm:right-6 sm:h-[720px] sm:max-h-[calc(100vh-3rem)] sm:w-[480px]"
  >
    <div class="border-b border-white/10 bg-white/5 p-4">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-sm font-bold text-cyan-200">Sophos</p>
          <p class="text-xs text-slate-400">AI Arsenal System Guide</p>
        </div>

        <button
          id="sophos-close"
          type="button"
          class="rounded-full border border-white/10 px-3 py-1 text-xs text-slate-300 transition hover:bg-white/10"
        >
          Close
        </button>
      </div>
    </div>

    <div id="sophos-messages" class="min-h-0 flex-1 space-y-3 overflow-y-auto px-4 py-4 text-sm">
      <div class="rounded-2xl bg-cyan-400/10 p-3 text-cyan-100">
        Hello, I’m Sophos, AI Arsenal Enterprise’s system guide. Ask me about Oscar, our systems, responsible AI, demonstrations, or how to contact us.
      </div>
    </div>

    <form id="sophos-form" class="flex shrink-0 gap-2 border-t border-white/10 p-3">
      <input
        id="sophos-input"
        type="text"
        maxlength="180"
        placeholder="Ask about AI Arsenal..."
        class="min-w-0 flex-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white outline-none placeholder:text-slate-500 focus:border-cyan-400/50"
      />

      <button type="submit" class="rounded-xl bg-cyan-400 px-4 py-2 text-sm font-bold text-slate-950 transition hover:bg-cyan-300">
        Send
      </button>
    </form>
  </div>
</div>

<script>
  import {
    blockedTopicAnswer,
    blockedTopics,
    createIntentActions,
    intents,
    suggestions,
    unknownQuestionAnswer
  } from '../data/sophosKnowledge';
  const toggle = document.getElementById('sophos-toggle');
  const panel = document.getElementById('sophos-panel');
  const baseUrl = panel?.dataset.baseUrl || '/';
  const closeButton = document.getElementById('sophos-close');
  const form = document.getElementById('sophos-form');
  const input = document.getElementById('sophos-input');
  const messages = document.getElementById('sophos-messages');
  const promptButtons = document.querySelectorAll('.sophos-prompt');

  let lastIntent = '';
  let lastTopicLabel = '';

  const intentActions = createIntentActions(baseUrl);

  const normalize = (value) => {
    return value.toLowerCase().replace(/[^\w\s]/g, '').replace(/\s+/g, ' ').trim();
  };

  const pickAnswer = (answers) => answers[Math.floor(Math.random() * answers.length)];

  const addMessage = (text, sender = 'bot') => {
    const bubble = document.createElement('div');
    bubble.className =
      sender === 'user'
        ? 'ml-auto max-w-[85%] rounded-2xl bg-cyan-400 px-3 py-2 text-slate-950'
        : 'max-w-[85%] rounded-2xl bg-white/5 px-3 py-2 text-slate-200';

    bubble.textContent = text;
    messages.appendChild(bubble);
    messages.scrollTop = messages.scrollHeight;
  };

  const addIntentActions = (intentName) => {
    const actions = intentActions[intentName] || [];

    if (!actions.length) {
      return;
    }

    const wrapper = document.createElement('div');
    wrapper.className = 'flex flex-wrap gap-2 pt-1';

    actions.forEach((action) => {
      const link = document.createElement('a');
      link.href = action.href;
      link.textContent = action.label;
      link.className =
        'inline-flex items-center justify-center rounded-full border border-cyan-400/25 bg-cyan-400/10 px-3 py-2 text-xs font-semibold text-cyan-100 transition hover:-translate-y-[1px] hover:border-cyan-300 hover:bg-cyan-400/20';

      if (action.external) {
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
      }

      if (action.closePanel) {
        link.addEventListener('click', () => {
          panel?.classList.add('hidden');
          panel?.classList.remove('flex');
        });
      }

      wrapper.appendChild(link);
    });

    messages.appendChild(wrapper);
    messages.scrollTop = messages.scrollHeight;
  };

  const clearFollowUps = () => {
    document.getElementById('sophos-followups')?.remove();
  };

  const addFollowUps = (intentName) => {
    clearFollowUps();

    const options = suggestions[intentName] || suggestions.overview;

    const wrapper = document.createElement('div');
    wrapper.id = 'sophos-followups';
    wrapper.className = 'grid gap-2 pt-2';

    const label = document.createElement('p');
    label.className = 'text-xs font-semibold uppercase tracking-[0.18em] text-cyan-300';
    label.textContent = 'Suggested next moves';
    wrapper.appendChild(label);

    options.forEach((question) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'rounded-xl border border-cyan-400/10 bg-cyan-400/5 px-3 py-2 text-left text-xs text-cyan-100 transition hover:-translate-y-[1px] hover:bg-cyan-400/10';
      button.textContent = question;
      button.addEventListener('click', () => askSophos(question));
      wrapper.appendChild(button);
    });

    messages.appendChild(wrapper);
    messages.scrollTop = messages.scrollHeight;
  };

  const showTyping = () => {
    const typing = document.createElement('div');
    typing.id = 'sophos-typing';
    typing.className = 'max-w-[85%] rounded-2xl bg-white/5 px-3 py-2 text-slate-400';
    typing.textContent = 'Sophos is analyzing...';
    messages.appendChild(typing);
    messages.scrollTop = messages.scrollHeight;
  };

  const hideTyping = () => {
    document.getElementById('sophos-typing')?.remove();
  };

  const typeMessage = (text, intentName = '') => {
    const bubble = document.createElement('div');
    bubble.className = 'max-w-[85%] rounded-2xl bg-white/5 px-3 py-2 text-slate-200';
    messages.appendChild(bubble);

    let i = 0;
    const typing = setInterval(() => {
      bubble.textContent = text.substring(0, i) + '|';
      i++;
      messages.scrollTop = messages.scrollHeight;

      if (i > text.length) {
        bubble.textContent = text;
        clearInterval(typing);

        const resolvedIntent =
          intentName ||
          lastIntent ||
          'overview';

        addIntentActions(resolvedIntent);
        addFollowUps(resolvedIntent);
      }
    }, 12);
  };

  const scoreIntent = (question, intent) => {
    return intent.keywords.reduce((score, keyword) => {
      return question.includes(keyword) ? score + keyword.length : score;
    }, 0);
  };

  const getAnswer = (question) => {
    const q = normalize(question);

    if (blockedTopics.some((topic) => q.includes(topic))) {
      return {
        intent: 'overview',
        label: 'AI Arsenal',
        answer: blockedTopicAnswer
      };
    }

    if (['more', 'tell me more', 'explain more', 'go deeper'].includes(q) && lastIntent) {
      const intent = intents.find((item) => item.name === lastIntent);
      return {
        intent: intent.name,
        label: intent.label,
        answer: `You asked about ${lastTopicLabel} earlier. Going deeper: ${pickAnswer(intent.answers)} A strong next question is what problem this solves or which demo to watch first.`
      };
    }

    const ranked = intents
      .map((intent) => ({ intent, score: scoreIntent(q, intent) }))
      .sort((a, b) => b.score - a.score);

    if (ranked[0].score > 0) {
      const matched = ranked[0].intent;
      const memoryLead = lastTopicLabel && lastTopicLabel !== matched.label
        ? "You asked about " + lastTopicLabel + " earlier. Connecting that to " + matched.label + ": "
        : '';

      lastIntent = matched.name;
      lastTopicLabel = matched.label;

      return {
        intent: matched.name,
        label: matched.label,
        answer: memoryLead + pickAnswer(matched.answers)
      };
    }

    return {
      intent: 'overview',
      label: 'AI Arsenal',
      answer: unknownQuestionAnswer
    };
  };

  const askSophos = (question) => {
    const trimmed = question.trim();
    if (!trimmed) return;

    clearFollowUps();
    addMessage(trimmed, 'user');
    showTyping();

    const delay = Math.min(900, 250 + trimmed.length * 8);

    window.setTimeout(() => {
      hideTyping();
      const result = getAnswer(trimmed);
      typeMessage(result.answer, result.intent);
    }, delay);
  };

  toggle?.addEventListener('click', () => {
    panel?.classList.toggle('hidden');
    panel?.classList.toggle('flex');
  });

  closeButton?.addEventListener('click', () => {
    panel?.classList.add('hidden');
    panel?.classList.remove('flex');
  });


  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    askSophos(input.value);
    input.value = '';
  });

  promptButtons.forEach((button) => {
    button.addEventListener('click', () => {
      askSophos(button.dataset.question || '');
    });
  });
</script>

<style>
  .sophos-pulse {
    animation: sophosFloat 2.2s ease-in-out infinite;
    position: relative;
  }

  .sophos-pulse:hover {
    transform: scale(1.08);
  }

  .sophos-pulse::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.25);
    animation: sophosGlow 2.2s ease-out infinite;
    z-index: -1;
  }

  .sophos-pulse::after {
    content: "Ask Sophos";
    position: absolute;
    right: 4.75rem;
    white-space: nowrap;
    border: 1px solid rgba(34, 211, 238, 0.25);
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.92);
    padding: 0.5rem 0.85rem;
    color: #cffafe;
    font-size: 0.75rem;
    font-weight: 700;
    box-shadow: 0 18px 40px rgba(8, 145, 178, 0.22);
    opacity: 0.95;
  }

  @keyframes sophosFloat {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-6px);
    }
  }

  @keyframes sophosGlow {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }

    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  @media (max-width: 640px) {
    .sophos-pulse::after {
      display: none;
    }
  }

  @keyframes softPulse {
    0%, 100% {
      box-shadow: 0 0 0 rgba(34, 211, 238, 0.25);
    }

    50% {
      box-shadow: 0 0 22px rgba(34, 211, 238, 0.65);
    }
  }

  .sophos-orb {
    animation: sophosFloat 2.2s ease-in-out infinite, softPulse 3s ease-in-out infinite;
  }
</style>
