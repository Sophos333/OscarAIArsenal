---
---

<!-- WAYPOINT: SOPHOS_AI_ARSENAL_ASSISTANT -->
<div id="sophos-root" class="fixed bottom-6 right-6 z-50">
  <button
    id="sophos-toggle"
    type="button"
    class="sophos-pulse flex h-16 w-16 items-center justify-center rounded-full border border-cyan-400/30 bg-cyan-400 text-2xl shadow-2xl shadow-cyan-900/40 transition hover:bg-cyan-300"
    aria-label="Open AI Arsenal assistant"
  >
    <img src="/images/cross-badge.png" alt="Sophos AI assistant" class="h-9 w-9 object-contain" />
  </button>

  <div
    id="sophos-panel"
    class="hidden h-[72vh] w-[340px] flex-col overflow-hidden rounded-3xl border border-white/10 bg-slate-950/95 text-white shadow-2xl shadow-cyan-950/50 backdrop-blur sm:w-[410px]"
  >
    <div class="border-b border-white/10 bg-white/5 p-4">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-sm font-bold text-cyan-200">Sophos</p>
          <p class="text-xs text-slate-400">AI Arsenal Assistant</p>
        </div>

        <button
          id="sophos-close"
          type="button"
          class="rounded-full border border-white/10 px-3 py-1 text-xs text-slate-300 transition hover:bg-white/10"
        >
          Close
        </button>
      </div>
    </div>

    <div id="sophos-messages" class="h-[240px] space-y-3 overflow-y-auto p-4 text-sm">
      <div class="rounded-2xl bg-cyan-400/10 p-3 text-cyan-100">
        Shalom, I’m Sophos. Ask me about AI Arsenal, Oscar’s systems, AI engineering, data analytics, automation, or the live demos.
      </div>
    </div>

        <!-- WAYPOINT: SOPHOS_QUICK_PROMPTS_COLLAPSIBLE -->
    <details class="border-t border-white/10 p-3">
      <summary class="cursor-pointer list-none rounded-xl border border-cyan-400/20 bg-cyan-400/10 px-3 py-2 text-sm font-bold text-cyan-100 transition hover:bg-cyan-400/15">
        Quick questions Sophos can answer
        <span class="ml-2 text-xs font-normal text-cyan-300">Click to expand or collapse</span>
      </summary>

      <div class="mt-2 grid max-h-[105px] gap-2 overflow-y-auto pr-1">
        <button class="sophos-prompt rounded-xl bg-white/5 px-3 py-2 text-left text-xs text-slate-200 transition hover:bg-cyan-400/10" data-question="What is AI Arsenal?">
          What is AI Arsenal?
        </button>

        <button class="sophos-prompt rounded-xl bg-white/5 px-3 py-2 text-left text-xs text-slate-200 transition hover:bg-cyan-400/10" data-question="What systems has Oscar built?">
          What systems has Oscar built?
        </button>

        <button class="sophos-prompt rounded-xl bg-white/5 px-3 py-2 text-left text-xs text-slate-200 transition hover:bg-cyan-400/10" data-question="Why should someone hire Oscar?">
          Why should someone hire Oscar?
        </button>

        <button class="sophos-prompt rounded-xl bg-white/5 px-3 py-2 text-left text-xs text-slate-200 transition hover:bg-cyan-400/10" data-question="How does this work under the hood?">
          How does this work under the hood?
        </button>

        <button class="sophos-prompt rounded-xl bg-white/5 px-3 py-2 text-left text-xs text-slate-200 transition hover:bg-cyan-400/10" data-question="How is this different from ChatGPT?">
          How is this different from ChatGPT?
        </button>

        <button class="sophos-prompt rounded-xl bg-white/5 px-3 py-2 text-left text-xs text-slate-200 transition hover:bg-cyan-400/10" data-question="Which demo should I watch first?">
          Which demo should I watch first?
        </button>

        <button class="sophos-prompt rounded-xl bg-white/5 px-3 py-2 text-left text-xs text-slate-200 transition hover:bg-cyan-400/10" data-question="How can I contact Oscar?">
          How can I contact Oscar?
        </button>
      </div>
    </details>
<div class="border-t border-white/10 px-3 pt-2">
      <button
        id="sophos-close-bottom"
        type="button"
        class="w-full rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-xs font-semibold text-slate-300 transition hover:bg-white/10"
      >
        Close Sophos
      </button>
    </div>

    <form id="sophos-form" class="flex gap-2 border-t border-white/10 p-3">
      <input
        id="sophos-input"
        type="text"
        maxlength="180"
        placeholder="Ask about AI Arsenal..."
        class="min-w-0 flex-1 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white outline-none placeholder:text-slate-500 focus:border-cyan-400/50"
      />

      <button type="submit" class="rounded-xl bg-cyan-400 px-4 py-2 text-sm font-bold text-slate-950 transition hover:bg-cyan-300">
        Send
      </button>
    </form>
  </div>
</div>

<script>
  const toggle = document.getElementById('sophos-toggle');
  const panel = document.getElementById('sophos-panel');
  const closeButton = document.getElementById('sophos-close');
  const closeButtonBottom = document.getElementById('sophos-close-bottom');
  const form = document.getElementById('sophos-form');
  const input = document.getElementById('sophos-input');
  const messages = document.getElementById('sophos-messages');
  const promptButtons = document.querySelectorAll('.sophos-prompt');

  let lastIntent = '';

  const normalize = (value) => {
    return value
      .toLowerCase()
      .replace(/[^\w\s]/g, '')
      .replace(/\s+/g, ' ')
      .trim();
  };

  const blockedTopics = [
    'recipe', 'food', 'pancake', 'malware', 'hack', 'exploit',
    'password', 'politics', 'gambling', 'crypto advice', 'casino',
    'weapon', 'illegal', 'adult', 'weather', 'movie', 'game cheat'
  ];

  const pickAnswer = (answers) => {
    return answers[Math.floor(Math.random() * answers.length)];
  };

  const addMessage = (text, sender = 'bot') => {
    const bubble = document.createElement('div');
    bubble.className =
      sender === 'user'
        ? 'ml-auto max-w-[85%] rounded-2xl bg-cyan-400 px-3 py-2 text-slate-950'
        : 'max-w-[85%] rounded-2xl bg-white/5 px-3 py-2 text-slate-200';

    bubble.textContent = text;
    messages.appendChild(bubble);
    messages.scrollTop = messages.scrollHeight;
  };

  const showTyping = () => {
    const typing = document.createElement('div');
    typing.id = 'sophos-typing';
    typing.className = 'max-w-[85%] rounded-2xl bg-white/5 px-3 py-2 text-slate-400';
    typing.textContent = 'Sophos is analyzing...';
    messages.appendChild(typing);
    messages.scrollTop = messages.scrollHeight;
  };

  const hideTyping = () => {
    document.getElementById('sophos-typing')?.remove();
  };

  const typeMessage = (text) => {
    const bubble = document.createElement('div');
    bubble.className = 'max-w-[85%] rounded-2xl bg-white/5 px-3 py-2 text-slate-200';
    messages.appendChild(bubble);

    let i = 0;
    const typing = setInterval(() => {
      bubble.textContent += text.charAt(i);
      i++;
      messages.scrollTop = messages.scrollHeight;

      if (i >= text.length) {
        clearInterval(typing);
      }
    }, 12);
  };

  const intents = [
    {
      name: 'overview',
      keywords: ['ai arsenal', 'what is this', 'what do you do', 'what is this site', 'what am i looking at', 'help'],
      answers: [
        'AI Arsenal is Oscar Holguin’s portfolio of AI, analytics, and automation systems built to reduce manual work and deliver decision-ready insights.',
        'You’re looking at AI Arsenal, a showcase of practical AI and data systems designed around automation, analytics, and business decision clarity.',
        'AI Arsenal is built to show working systems, not just project screenshots. The focus is proof, demos, and real-world use cases.'
      ]
    },
    {
      name: 'systems',
      keywords: ['projects', 'systems', 'what has oscar built', 'portfolio', 'tools', 'demos'],
      answers: [
        'Oscar has built AI Contract Reviewer, Excel Whisperer, and ReadmitGuard. Each system shows a different kind of applied AI, analytics, automation, or prediction workflow.',
        'The featured systems are AI Contract Reviewer for risk analysis, Excel Whisperer for spreadsheet automation, and ReadmitGuard for healthcare prediction workflows.',
        'These systems demonstrate practical AI product thinking: input, analysis, structured output, and decision support.'
      ]
    },
    {
      name: 'contract',
      keywords: ['contract', 'reviewer', 'legal', 'risk analysis', 'agreement'],
      answers: [
        'AI Contract Reviewer analyzes agreements, surfaces risk signals, extracts key fields, and turns contract complexity into clearer business insight.',
        'The contract system is designed to help users scan agreements faster, identify risks, and understand key terms without getting lost in the full document.',
        'AI Contract Reviewer demonstrates risk detection, field extraction, source-aware review, and decision-ready summaries.'
      ]
    },
    {
      name: 'excel',
      keywords: ['excel', 'whisperer', 'spreadsheet', 'reporting', 'manual reporting'],
      answers: [
        'Excel Whisperer focuses on spreadsheet automation, data analysis, and insight generation using Python-driven workflows.',
        'Excel Whisperer is built around a common business problem: too much manual spreadsheet work and not enough fast insight.',
        'The Excel system shows how Python and automation can turn spreadsheet-heavy workflows into faster, cleaner analysis.'
      ]
    },
    {
      name: 'readmit',
      keywords: ['readmit', 'readmission', 'healthcare', 'patient', 'prediction', 'csv'],
      answers: [
        'ReadmitGuard demonstrates healthcare analytics through patient readmission risk prediction, including manual single-patient scoring and CSV batch processing.',
        'ReadmitGuard shows how predictive analytics can support healthcare decision workflows by estimating readmission risk from patient data.',
        'The ReadmitGuard demos show two workflows: single-patient manual entry and CSV batch prediction for larger datasets.'
      ]
    },
    {
      name: 'technical',
      keywords: ['under the hood', 'how does this work', 'tech stack', 'python', 'sql', 'machine learning', 'ai model', 'architecture'],
      answers: [
        'The AI Arsenal stack highlights Python, SQL, data processing, automation, machine learning concepts, Streamlit apps, and business intelligence workflows.',
        'Under the hood, these systems usually combine data ingestion, cleaning, analysis logic, structured outputs, and a user-facing interface for decision support.',
        'The technical pattern is practical: collect the data, structure it, analyze it, surface insights, and present the result in a way a user can act on.'
      ]
    },
    {
      name: 'business',
      keywords: ['business', 'help my business', 'problems', 'solve', 'manual work', 'time save', 'replace manual', 'value'],
      answers: [
        'AI Arsenal systems are designed to reduce manual work, surface important risks or patterns, and help teams make clearer decisions faster.',
        'The business value is workflow clarity: fewer manual steps, better visibility, faster analysis, and more consistent decision support.',
        'These tools help by turning messy data, documents, or workflows into structured outputs that leaders can act on.'
      ]
    },
    {
      name: 'hiring',
      keywords: ['hire', 'available', 'recruiter', 'job', 'remote', 'work with', 'roles', 'why hire'],
      answers: [
        'Oscar is positioned for AI engineering, data analytics, automation, business intelligence, and operational decision-support roles.',
        'Oscar can bring value in roles involving AI tools, analytics systems, workflow automation, reporting, dashboards, and process optimization.',
        'For hiring conversations, the strongest fit is work that combines data, AI, automation, and decision support for business teams.'
      ]
    },
    {
      name: 'chatgpt',
      keywords: ['chatgpt', 'different from chatgpt', 'why not chatgpt', 'real ai'],
      answers: [
        'ChatGPT is general-purpose. AI Arsenal systems are focused workflows built around specific tasks, data, outputs, and decision needs.',
        'The difference is structure. These tools are designed around repeatable business workflows, not open-ended chatting.',
        'AI Arsenal uses AI as part of a system: inputs, rules, outputs, review flow, and business context.'
      ]
    },
    {
      name: 'contact',
      keywords: ['contact', 'linkedin', 'email', 'connect', 'reach'],
      answers: [
        'You can contact Oscar through LinkedIn or by email at AI.Arsenalenterprise@gmail.com.'
      ]
    }
  ];

  const scoreIntent = (question, intent) => {
    return intent.keywords.reduce((score, keyword) => {
      return question.includes(keyword) ? score + keyword.length : score;
    }, 0);
  };

  const getAnswer = (question) => {
    const q = normalize(question);

    if (blockedTopics.some((topic) => q.includes(topic))) {
      return 'I’m focused on AI Arsenal, Oscar’s AI systems, data analytics, automation, and project demos. Try asking how a system works, what problem it solves, or how it helps a team.';
    }

    if (['more', 'tell me more', 'explain more', 'go deeper'].includes(q) && lastIntent) {
      const intent = intents.find((item) => item.name === lastIntent);
      return `Going deeper: ${pickAnswer(intent.answers)} A good follow-up is to ask what problem this solves or which demo to watch first.`;
    }

    const ranked = intents
      .map((intent) => ({ intent, score: scoreIntent(q, intent) }))
      .sort((a, b) => b.score - a.score);

    if (ranked[0].score > 0) {
      lastIntent = ranked[0].intent.name;
      return pickAnswer(ranked[0].intent.answers);
    }

    return pickAnswer([
      'Good question. I can help with AI Arsenal systems, Oscar’s projects, automation, data analytics, and business use cases. Try asking what a system does or how it could help a team.',
      'I’m tuned for AI Arsenal topics. Ask me about systems, business use cases, technical stack, or the live demos.',
      'Try asking about AI Contract Reviewer, Excel Whisperer, ReadmitGuard, Oscar’s skills, or how these systems support better decisions.'
    ]);
  };

  const askSophos = (question) => {
    const trimmed = question.trim();
    if (!trimmed) return;

    addMessage(trimmed, 'user');
    showTyping();

    const delay = 350 + Math.random() * 700;

    window.setTimeout(() => {
      hideTyping();
      typeMessage(getAnswer(trimmed));
    }, delay);
  };

  toggle?.addEventListener('click', () => {
    panel?.classList.toggle('hidden');
    panel?.classList.toggle('flex');
  });

  closeButton?.addEventListener('click', () => {
    panel?.classList.add('hidden');
    panel?.classList.remove('flex');
  });

  closeButtonBottom?.addEventListener('click', () => {
    panel?.classList.add('hidden');
    panel?.classList.remove('flex');
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    askSophos(input.value);
    input.value = '';
  });

  promptButtons.forEach((button) => {
    button.addEventListener('click', () => {
      askSophos(button.dataset.question || '');
    });
  });
</script>

<style>
  .sophos-pulse {
    animation: sophosFloat 2.2s ease-in-out infinite;
    position: relative;
  }

  .sophos-pulse:hover {
    transform: scale(1.08);
  }

  .sophos-pulse::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.25);
    animation: sophosGlow 2.2s ease-out infinite;
    z-index: -1;
  }

  .sophos-pulse::after {
    content: "Ask Sophos";
    position: absolute;
    right: 4.75rem;
    white-space: nowrap;
    border: 1px solid rgba(34, 211, 238, 0.25);
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.92);
    padding: 0.5rem 0.85rem;
    color: #cffafe;
    font-size: 0.75rem;
    font-weight: 700;
    box-shadow: 0 18px 40px rgba(8, 145, 178, 0.22);
    opacity: 0.95;
  }

  @keyframes sophosFloat {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-6px);
    }
  }

  @keyframes sophosGlow {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }

    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  @media (max-width: 640px) {
    .sophos-pulse::after {
      display: none;
    }
  }
</style>








